MOCK_ML_URL=http://127.0.0.1:8001
MOCK_TOIR_URL=http://127.0.0.1:8002
MOCK_API_TIMEOUT=5
LOW_CONFIDENCE_THRESHOLD=0.60

# Необязательно: внешний ZIP, распакованный комплект или каталог с ним.
# По умолчанию архив ищется в корне; ручная распаковка не нужна.
# CUSTOMER_ARCHIVE_PATH=007_хакатон_ИИ.zip

# Порт приложения на компьютере при docker compose up (в контейнере остаётся 8000)
APP_PORT=8000

# Встроенный агент в общем экране. Ollama запускается отдельно.
CASE_AGENT=0
AGENT_MODEL=gemma2:2b
# Локально адрес по умолчанию http://127.0.0.1:11434;
# Compose использует http://host.docker.internal:11434.
# OLLAMA_HOST_URL=http://127.0.0.1:11434

# Пути со значениями по умолчанию
# CUSTOMER_DIR=artifacts/customer
# MANUALS_DIR=artifacts/manuals
# TEAM_MANUALS_INDEX=artifacts/manual-corpus.json
# MECHANIC_DB=artifacts/mechanic-assistant.sqlite3
# TEAM_DB_PATH=artifacts/mechanic.sqlite3

TEAM_API_URL=
TEAM_AGENT_URL=
TEAM_API_TIMEOUT=20

OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
# Модель формулировки ответа для основного экрана и отдельного backend.
# OLLAMA_GENERATION_MODEL=qwen3.5:9b
# LOCAL_OLLAMA_MODELS=D:/Ollama/DigitalMechanicModels
# OLLAMA_TIMEOUT_SECONDS=30
